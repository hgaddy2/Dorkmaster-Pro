{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "resultsPerPage": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Search": {
      "title": "Search History",
      "description": "Records of past searches performed by users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "query": { "type": "string" },
        "filters": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "query", "timestamp"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved search results or dorks.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "dork": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "timestamp"]
    },
    "CustomDork": {
      "title": "Custom Dork",
      "description": "User-created dork templates.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "dork": { "type": "string" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "dork", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/searches/{searchId}": {
      "schema": "Search",
      "description": "Search history records."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User bookmarks."
    },
    "/customDorks/{dorkId}": {
      "schema": "CustomDork",
      "description": "User custom dorks."
    }
  }
}
